# the old mpm bootstrap layout that is no longer used by mpm >= 1.0.0.
# The mpm catalog audit command detects this directory and emits a WARN finding.
# See docs/migration-bootstrap-to-add.md for the migration guide.
GITBASE=https://example.com/org
CLAUDE_MARKETPLACES_DIR=${HOME}/.claude-marketplaces
MPM_MARKETPLACE_INSTALL=false
